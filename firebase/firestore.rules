rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function okStr(data, field, max) {
      return !(field in data) || data[field] == null ||
             (data[field] is string && data[field].size() <= max);
    }
    function okList(data, field, max) {
      return !(field in data) || data[field] == null ||
             (data[field] is list && data[field].size() <= max);
    }
    function okMap(data, field, max) {
      return !(field in data) || (data[field] is map && data[field].size() <= max);
    }
    // The signed-in user shares at least one pod with userId.
    function sharesPodWith(userId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('podIds', []).hasAny(
        get(/databases/$(database)/documents/users/$(userId)).data.get('podIds', [])
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && okStr(request.resource.data, 'displayName', 80)
        && okStr(request.resource.data, 'archidektProfileUrl', 300)
        && okStr(request.resource.data, 'moxfieldProfileUrl', 300)
        && okList(request.resource.data, 'podIds', 40);
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /decks/{deckId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          (
            resource.data.secret != true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('podIds', []).hasAny(
              get(/databases/$(database)/documents/users/$(userId)).data.get('podIds', [])
            )
          )
        );
        allow create, update: if request.auth != null && request.auth.uid == userId
          && okStr(request.resource.data, 'list', 40000)
          && okStr(request.resource.data, 'deckName', 300)
          && okStr(request.resource.data, 'commander', 200)
          && okStr(request.resource.data, 'player', 80)
          && okStr(request.resource.data, 'key', 400)
          && okStr(request.resource.data, 'lastChartedBy', 80);
        // Deck Log: a podmate who charts a shared deck adds exactly 1 to its view count and records
        // when and by whom. Nothing else on the deck can change.
        allow update: if request.auth != null && request.auth.uid != userId
          && resource.data.get('secret', false) != true
          && sharesPodWith(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['podViewCount', 'lastChartedAt', 'lastChartedBy'])
          && request.resource.data.podViewCount == resource.data.get('podViewCount', 0) + 1
          && request.resource.data.lastChartedAt is number
          && request.resource.data.lastChartedBy is string
          && request.resource.data.lastChartedBy.size() <= 80;
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Deck Log change entries: written by the deck's owner; readable like the deck itself.
        match /changes/{changeId} {
          allow read: if request.auth != null && (
            request.auth.uid == userId ||
            (
              get(/databases/$(database)/documents/users/$(userId)/decks/$(deckId)).data.get('secret', false) != true &&
              sharesPodWith(userId)
            )
          );
          allow create, update: if request.auth != null && request.auth.uid == userId
            && okList(request.resource.data, 'added', 300)
            && okList(request.resource.data, 'removed', 300)
            && okStr(request.resource.data, 'note', 280);
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // Deck notes (View Deck): one document, notes/current, holding the primer and card notes.
        // Written by the owner; readable like the deck itself.
        match /notes/{noteId} {
          allow read: if request.auth != null && (
            request.auth.uid == userId ||
            (
              get(/databases/$(database)/documents/users/$(userId)/decks/$(deckId)).data.get('secret', false) != true &&
              sharesPodWith(userId)
            )
          );
          allow create, update: if request.auth != null && request.auth.uid == userId
            && noteId == 'current'
            && okStr(request.resource.data, 'primer', 20000)
            && okMap(request.resource.data, 'cards', 300)
            && (!('shareForTuning' in request.resource.data) || request.resource.data.shareForTuning is bool);
          allow delete: if request.auth != null && request.auth.uid == userId;
        }

        // Spark checks: the owner's "stronger / about right / weaker than its Spark" after a battle.
        match /sparkChecks/{checkId} {
          allow read: if request.auth != null && (
            request.auth.uid == userId ||
            (
              get(/databases/$(database)/documents/users/$(userId)/decks/$(deckId)).data.get('secret', false) != true &&
              sharesPodWith(userId)
            )
          );
          allow create, update: if request.auth != null && request.auth.uid == userId
            && request.resource.data.verdict in ['stronger', 'right', 'weaker']
            && okStr(request.resource.data, 'podId', 80);
          allow delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /trades/{tradeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && okStr(request.resource.data, 'card', 200)
          && okStr(request.resource.data, 'shop', 100)
          && okStr(request.resource.data, 'note', 400)
          && okList(request.resource.data, 'sells', 40);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /spoilerVotes/{cardKey} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('podIds', []).hasAny(
            get(/databases/$(database)/documents/users/$(userId)).data.get('podIds', [])
          )
        );
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.vote in ['like', 'pass']
          && okStr(request.resource.data, 'key', 120)
          && okStr(request.resource.data, 'n', 200)
          && okStr(request.resource.data, 'setName', 100);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /linkedDecks/{deckId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && okStr(request.resource.data, 'decklistText', 40000)
          && okStr(request.resource.data, 'name', 300)
          && okStr(request.resource.data, 'commander', 200)
          && okStr(request.resource.data, 'url', 500);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /pods/{podId} {
      function canManageChronicle() {
        let pod = get(/databases/$(database)/documents/pods/$(podId)).data;
        let players = resource.data.get('participants', []);
        return request.auth.uid in pod.memberIds
          && (pod.leaderId == request.auth.uid
              || request.auth.uid in pod.get('coLeaderIds', [])
              || players.size() == 0
              || request.auth.uid in players);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.leaderId == request.auth.uid
        && okStr(request.resource.data, 'name', 120)
        && okList(request.resource.data, 'memberIds', 40);
      allow update: if request.auth != null && (
        resource.data.leaderId == request.auth.uid ||
        request.auth.uid in resource.data.coLeaderIds ||
        request.auth.uid in request.resource.data.memberIds ||
        request.auth.uid in resource.data.memberIds
      )
        && okStr(request.resource.data, 'name', 120)
        && okList(request.resource.data, 'memberIds', 40);
      allow delete: if request.auth != null && resource.data.leaderId == request.auth.uid;

      match /members/{memberUid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/pods/$(podId)).data.leaderId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.coLeaderIds
        )
          && okStr(request.resource.data, 'displayName', 80);
        allow delete: if request.auth != null && (
          request.auth.uid == memberUid ||
          get(/databases/$(database)/documents/pods/$(podId)).data.leaderId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.coLeaderIds
        );
      }

      match /tableFormations/{formationId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
        allow create, update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds
          && okStr(request.resource.data, 'name', 120)
          && okList(request.resource.data, 'seats', 12);
        allow delete: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
      }

      match /chronicles/{entryId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds
          && okStr(request.resource.data, 'notes', 1000)
          && okStr(request.resource.data, 'gatheringTitle', 160)
          && okList(request.resource.data, 'decks', 12)
          && okList(request.resource.data, 'participants', 24)
          && okList(request.resource.data, 'feedbackResponses', 48);
        allow update: if request.auth != null && canManageChronicle()
          && okStr(request.resource.data, 'notes', 1000)
          && okStr(request.resource.data, 'notesEditedBy', 80)
          && okStr(request.resource.data, 'gatheringTitle', 160)
          && okList(request.resource.data, 'decks', 12)
          && okList(request.resource.data, 'participants', 24)
          && okList(request.resource.data, 'feedbackResponses', 48);
        allow delete: if request.auth != null && canManageChronicle();
      }

      match /settings/{settingId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
        allow create, update: if request.auth != null
          && settingId == 'impactCards'
          && (get(/databases/$(database)/documents/pods/$(podId)).data.leaderId == request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.get('coLeaderIds', []))
          && (!('changes' in request.resource.data)
              || (request.resource.data.changes is map && request.resource.data.changes.size() <= 70));
        allow delete: if request.auth != null &&
          get(/databases/$(database)/documents/pods/$(podId)).data.leaderId == request.auth.uid;
      }

      match /impactNominations/{cardKey} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds
          && request.resource.data.by == request.auth.uid
          && request.resource.data.card is string
          && request.resource.data.card.size() <= 200
          && okStr(request.resource.data, 'note', 400)
          && okStr(request.resource.data, 'byName', 80);
        allow update: if request.auth != null
          && resource.data.by == request.auth.uid
          && request.resource.data.by == request.auth.uid
          && request.resource.data.card is string
          && request.resource.data.card.size() <= 200
          && okStr(request.resource.data, 'note', 400)
          && okStr(request.resource.data, 'byName', 80);
        allow delete: if request.auth != null && (
          resource.data.by == request.auth.uid ||
          get(/databases/$(database)/documents/pods/$(podId)).data.leaderId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.get('coLeaderIds', []));
      }

      match /activity/{activityId} {
        // Feeds each member's notification bell. One record per event; written once, never edited.
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds
          && request.resource.data.by == request.auth.uid
          && request.resource.data.type in ['deck', 'gathering', 'live', 'nomination', 'joined', 'invite', 'rsvp', 'cancelled']
          && okStr(request.resource.data, 'subject', 160)
          && okStr(request.resource.data, 'byName', 80)
          && okStr(request.resource.data, 'ref', 80)
          && okList(request.resource.data, 'to', 12);
        allow update: if false;
        allow delete: if request.auth != null && (
          resource.data.by == request.auth.uid ||
          get(/databases/$(database)/documents/pods/$(podId)).data.leaderId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.get('coLeaderIds', []));
      }

      match /gatherings/{gatheringId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
        allow create, update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds
          && okStr(request.resource.data, 'title', 160);
        allow delete: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/pods/$(podId)).data.memberIds;
      }
    }
  }
}
