{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(/public/data/**)",
      "Write(/public/data/**)",
      "Edit(**/generated/**)",
      "Write(**/generated/**)",
      "Edit(**/*.generated.*)",
      "Write(**/*.generated.*)"
    ]
  }
}
